# SHELTRON Backend Environment Variables
# --------------------------------------
# Application Port (automatically set by hosting platforms like Render, Railway, Heroku)
PORT=8000

# Production Frontend URL for Netlify:
FRONTEND_URL=https://sheltron.netlify.app

# Additional allowed origins (comma-separated):
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional flag: set to 'true' to allow all origins during judge demos or staging tests
ALLOW_ALL_ORIGINS=false
