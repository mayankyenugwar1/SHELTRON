# SHELTRON Frontend Environment Variables
# ----------------------------------------
# In local development:
# - Leave empty to use Vite's internal proxy (/api -> http://127.0.0.1:8000)
# - Or set to http://localhost:8000 to connect directly
#
# In production (Netlify Site Configuration -> Environment Variables):
# - Set VITE_API_URL to your deployed FastAPI backend URL:
#   e.g. VITE_API_URL=https://sheltron-backend.onrender.com

VITE_API_URL=http://localhost:8000
