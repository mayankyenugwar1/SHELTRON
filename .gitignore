# SHELTRON Root .gitignore

# Dependencies
node_modules/
frontend/node_modules/

# Production build outputs
dist/
frontend/dist/
dist-ssr/

# Python Virtual Environments & Bytecode
venv/
backend/venv/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Environment Variables & Secrets (Keep examples committed)
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS & Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
